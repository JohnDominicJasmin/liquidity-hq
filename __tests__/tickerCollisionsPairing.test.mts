/* #1944: TICKER_COLLISIONS and the generated universe must not drift apart.
 *
 * DEV TEAM ASKED FOR THE PAIRING, NOT THE LIST, and they were right about why. Their first pass
 * excluded all three tickers as OKX collisions; the expiry re-check answered `on: 1.000 - NOT A
 * COLLISION ANY MORE` within five minutes, because the original comparison used Binance as `on`'s
 * reference and the re-check used Bybit. Without that re-check, `bb` and `qnt` would have been right
 * and **`on` would have been wrong in a way that still looked handled**. That is the failure these
 * cells exist for: the file says "handled" and the guard no longer agrees.
 *
 * WHAT THIS DELIBERATELY DOES NOT DO: run the generator. That calls Bybit, Binance and OKX, so a
 * suite cell doing it would be slow, flaky on a venue outage, and would spend rate limit on every
 * run - for an answer that depends on live prices rather than on this repo. The other half of Dev's
 * ask, "removing an entry makes the generator exit 2", was measured by hand during review and is
 * recorded on #1944: removing `['on','binance']` exits 2 naming `x4.718e+2`, removing `['bb','okx']`
 * exits 2 naming `x7.870e-4`, and both leave the generated file byte-identical.
 *
 * So these cells pin the part that IS a property of the repo: every entry in the list is reflected
 * in the shipped file, and every claim the list makes about itself is true of the file.
 */
import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const SCRIPT = path.join(ROOT, 'scripts', 'generate-coins.mjs');
const UNIVERSE = path.join(ROOT, 'lib', 'coinUniverse.generated.ts');

const scriptSrc = readFileSync(SCRIPT, 'utf8');
const universeSrc = readFileSync(UNIVERSE, 'utf8');

/** The list as the generator declares it: id -> the venue dropped for that id. */
const collisions = (() => {
  const block = /const TICKER_COLLISIONS = new Map\(\[([\s\S]*?)\]\);/.exec(scriptSrc);
  assert.ok(block, 'TICKER_COLLISIONS is no longer a `new Map([...])` literal in scripts/generate-coins.mjs. These cells read it as source because the generator is not importable without running its network fetches - if the shape changed, update the parser rather than deleting the cells.');
  return new Map([...block[1].matchAll(/\[\s*'([^']+)'\s*,\s*'([^']+)'\s*\]/g)].map((m) => [m[1], m[2]]));
})();

/** Each row of the shipped universe, by id, as a field map. */
const rows = (() => {
  const out = new Map();
  for (const m of universeSrc.matchAll(/\{\s*id:\s*'([^']+)'([^}]*)\}/g)) {
    const fields = Object.fromEntries(
      [...m[2].matchAll(/(\w+):\s*('[^']*'|null|true|false|[\d.]+)/g)].map((f) => [f[1], f[2]]),
    );
    out.set(m[1], fields);
  }
  return out;
})();

test('C1. PREMISE: both sources parsed, so the cells below are reading something', () => {
  assert.ok(collisions.size > 0,
    'TICKER_COLLISIONS parsed as EMPTY. Every assertion below would then pass by having nothing to check - the exact silent-pass this file is about.');
  assert.ok(rows.size > 100,
    `only ${rows.size} universe rows parsed, so the row regex has stopped matching the generated file's shape and the pairing cells are comparing against almost nothing`);
  /* The parser must be able to see a nulled venue, or C2 cannot fail. */
  const anyNull = [...rows.values()].some((f) => Object.values(f).includes('null'));
  assert.ok(anyNull, 'no row parsed with any field as `null`, so C2 cannot distinguish a dropped venue from a present one');
});

test('C2. every TICKER_COLLISIONS entry is reflected in the shipped row - the list cannot claim a drop the file does not have', () => {
  const wrong: string[] = [];
  for (const [id, venue] of collisions) {
    const row = rows.get(id);
    if (!row) { wrong.push(`${id}: in TICKER_COLLISIONS but NOT in the universe at all`); continue; }
    if (!(venue in row)) { wrong.push(`${id}: the list drops '${venue}' but the row has no such field`); continue; }
    if (row[venue] !== 'null') wrong.push(`${id}: the list drops '${venue}' but the row ships ${row[venue]}`);
  }
  assert.deepEqual(wrong, [],
    `${wrong.join(' | ')}\n\nTICKER_COLLISIONS and lib/coinUniverse.generated.ts disagree. Either the file was regenerated by something that ignored the list, or an entry was added without regenerating. This is the drift Dev Team flagged on #1944: the list reading "handled" while the shipped row still pairs two different assets.`);
});

test('C3. oneVenue counts BYBIT AND BINANCE ONLY - adding the OKX column did not move it', () => {
  /* MY FIRST VERSION OF THIS CELL COUNTED OKX AND WENT RED ON THREE ROWS - fet, on and xau - and
     the data was right while the cell was wrong. `scripts/generate-coins.mjs:227` is
     `const oneVenue = !b || !n;` over Bybit and Binance; line 181 says the id set is still
     "Bybit n Binance plus ONE_VENUE_KEEP", so OKX is emitted and deliberately NOT part of the venue
     logic in step 1. `lib/coins.ts:188` goes further: the live failover question is answered from the
     SHIPPED MAPS, not from this flag, because the two disagreed for pepe and bonk and a caller was
     told a failover existed that did not.

     So the property worth pinning is the one a later OKX step could break silently: if OKX ever
     starts counting, `oneVenue` flips for those three rows AND `liq` changes with it (line 230 ranks
     on the thinner venue), which moves the one-venue filter and the liquidity rank at once. That is
     a behaviour change that should arrive in a PR that says so, not as a side effect. */
  const wrong: string[] = [];
  const okxOnlySecond: string[] = [];
  for (const [id, row] of rows) {
    if (!('oneVenue' in row)) continue;
    const pair = ['bybit', 'binance'].filter((v) => row[v] !== 'null');
    const hasOkx = 'okx' in row && row.okx !== 'null';
    const claims = row.oneVenue === 'true';

    if ((pair.length === 1) !== claims) {
      wrong.push(`${id}: bybit/binance=${pair.length} (${pair.join(',') || 'none'}) but oneVenue:${row.oneVenue}`);
    }
    if (pair.length === 1 && hasOkx) okxOnlySecond.push(id);
  }
  assert.deepEqual(wrong, [],
    `${wrong.join(' | ')}\n\noneVenue no longer equals "exactly one of bybit/binance". If OKX is now meant to count, say so in the PR - it also changes liq, which ranks on the thinner venue.`);

  /* The three rows that make this cell non-vacuous: one of the original pair, plus an OKX symbol.
     If this list ever empties, the cell stops distinguishing the two definitions. */
  assert.ok(okxOnlySecond.length > 0,
    'no row has exactly one of bybit/binance AND an OKX symbol, so this cell can no longer tell "oneVenue counts OKX" from "it does not" - it would pass under either definition');
  console.log(`      rows where OKX is the only second venue (so the definition is observable): ${okxOnlySecond.join(', ')}`);
});

test('C4. CONTROL: each cell is shown to fail on a planted disagreement', () => {
  /* C2 and C3 are deepEqual-against-empty, which is the shape that passes when a filter stops
     matching. Planting proves the comparisons still discriminate. */
  const fakeRows = new Map(rows);
  const victim = [...collisions.keys()][0];
  const venue = collisions.get(victim)!;

  /* C2's shape: the list drops a venue the file still ships. */
  fakeRows.set(victim, { ...rows.get(victim)!, [venue]: "'RESTOREDUSDT'" });
  const c2 = [...collisions].filter(([id, v]) => fakeRows.get(id)?.[v] !== 'null').map(([id]) => id);
  assert.deepEqual(c2, [victim],
    `planting a restored '${venue}' on '${victim}' did not make C2's comparison fire, so that cell cannot catch the drift it is written for`);

  /* C3's shape: a single-venue row still claiming oneVenue:false. */
  const single = { bybit: "'XUSDT'", binance: 'null', okx: 'null', oneVenue: 'false' };
  const venues = ['bybit', 'binance', 'okx'].filter((v) => single[v as keyof typeof single] !== 'null');
  assert.equal(venues.length, 1, 'the planted row is not single-venue, so this control proves nothing');
  assert.ok(venues.length === 1 && single.oneVenue !== 'true',
    "C3's comparison would not fire on a single-venue row claiming oneVenue:false");
});
