# Liquidity Hunter HQ - Environment Variables
# Copy to .env.local for local dev, or paste into Render's Environment tab.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App URL ───────────────────────────────────────────────────────────────────
# The canonical public URL of THIS deployment. Used server-side wherever a
# route needs to build an absolute link back to itself (Telegram webhook
# registration, email links) instead of trusting a spoofable Host header.
# REQUIRED per environment - if unset, telegram/setup-webhook builds a
# localhost URL and Telegram rejects the registration (this bit prod once).
NEXT_PUBLIC_APP_URL=https://your-deployment.onrender.com

# Without these, Cluster Tracker and AI Arena signal history are disabled.
# The rest of the app (live data, scanner, bible, hours) works without Supabase.

# ── Cloudflare Turnstile (CAPTCHA on login) ───────────────────────────────────
# Stops scripted/bot account creation via the magic-link sign-in form - the
# durable fix for unlimited-trial-account farming. Create a widget at
# https://dash.cloudflare.com -> Turnstile, then:
#  1. Paste the SITE key here (public by design, safe to expose to the browser).
#  2. Paste the SECRET key into Supabase Dashboard -> Authentication -> Settings
#     -> Bot and Abuse Protection -> Enable CAPTCHA protection (provider:
#     Turnstile). The secret never touches this app/repo.
# Unset = no widget rendered, login form works exactly as without this feature.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── CoinMarketCap ─────────────────────────────────────────────────────────────
# BTC/ETH dominance (CMC methodology, matches TradingView) + Alt Season Index
CMC_API_KEY=your_cmc_key_here

# ── PostHog Analytics ─────────────────────────────────────────────────────────
# Get from: https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Grok (xAI) ───────────────────────────────────────────────────────────────
GROK_API_KEY=xai-...
# App-wide daily circuit breaker on top of the per-user AI usage caps
# (lib/aiUsage.ts) - once today's total xAI calls across ALL users hits this
# number, every AI route blocks regardless of who's asking. Stops a fleet of
# accounts each staying under their own cap from collectively blowing the
# budget. Unset/0 = breaker disabled (per-user caps still apply).
AI_GLOBAL_DAILY_MAX=

# ── Coinglass ────────────────────────────────────────────────────────────────
# Free tier available - register at coinglass.com to get a key
# Powers: BTC liquidation heatmap (Arena), exchange net flow
COINGLASS_API_KEY=your_coinglass_key_here

# ── Finnhub ───────────────────────────────────────────────────────────────────
FINNHUB_KEY=your_finnhub_key_here

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Random string of your choosing - locks down /api/telegram/webhook so only
# real Telegram calls (which echo this back) are accepted. Set this, then hit
# /api/telegram/setup-webhook once to re-register the webhook with it.
TELEGRAM_WEBHOOK_SECRET=

# ── Cron / internal routes ────────────────────────────────────────────────────
# Protects /api/telegram/alert, /api/macro-alert, /api/signals/track,
# /api/telegram/setup-webhook from being triggered by anyone who finds the URL.
CRON_SECRET=

# ── Admin panel ──────────────────────────────────────────────────────────────
# Emergency-BOOTSTRAP owner(s), comma-separated. Server-only (no NEXT_PUBLIC_).
# Real admin membership now lives in the lhq_admin_users table, managed from the
# /ops Team page. These emails are ALWAYS treated as owner (and auto-seeded into
# admin_users on login) so you can never lock yourself out - keep at least your
# own here. The panel lives at /ops (login at /ops/login); the old /admin path is
# a honeypot that logs the hit and 404s.
ADMIN_EMAILS=mikocabal27@gmail.com

# ── Email notifications (Brevo) ───────────────────────────────────────────────
# Best-effort transactional email, used to notify someone when they're added as
# an admin on the /ops Team page. Single-sender: no domain needed - verify the
# sender address (e.g. your Gmail) in Brevo, then set it here. Both unset = the
# feature is inert (adding admins still works, just no email is sent).
# Free tier ~300 emails/day. Get the API key at https://app.brevo.com (SMTP & API).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ── Error tracking (Sentry SDK -> GlitchTip) ───────────────────────────────────
# Catches server + client crashes (Grok call failures, cron errors, blank-screen
# bugs) that today ship silently. Uses the @sentry/nextjs SDK, but pointed at
# GlitchTip (glitchtip.com) - an open-source, Sentry-protocol-compatible error
# tracker, since sentry.io's free tier is gone. No code changes needed either
# way; the DSN is what selects the backend. Get it from a GlitchTip project's
# settings page. DSNs aren't secret - NEXT_PUBLIC_ is correct here, not a leak.
# Unset = Sentry.init no-ops, feature stays off.
#
# SET THIS ON PRODUCTION ONLY. All three services once pointed at the same
# GlitchTip project (25983) sharing one 1,000-event/month free quota, and dev
# plus qa spent it - a forced error from prod AND staging both returned HTTP 429,
# so production monitoring was dead and nothing said so (issue #57).
# lib/monitoring.ts now suppresses the DSN whenever NEXT_PUBLIC_APP_ENV is 'dev',
# which covers both dev and qa, so leaving it set here is inert rather than
# harmful - but unset it on those services anyway. Belt and braces, because the
# failure mode is silent.
NEXT_PUBLIC_SENTRY_DSN=

# Error-tracker environment label. Optional, and only meaningful on a service
# that actually reports - which today is production alone, so this is currently
# inert everywhere. Exists because NEXT_PUBLIC_APP_ENV is a SWITCH, not a label
# (see docs/INFRASTRUCTURE.md 4b): qa must run as 'dev' to keep reading the dev
# tables, so it cannot label itself. Keep it for the day non-prod gets its own
# GlitchTip project.
NEXT_PUBLIC_SENTRY_ENV=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys once: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
# Public key is exposed to the browser (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:mikocabal27@gmail.com
