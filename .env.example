# Liquidity Hunter HQ - Environment Variables
# Copy to .env.local for local dev, or paste into Render's Environment tab.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Without these, Cluster Tracker and AI Arena signal history are disabled.
# The rest of the app (live data, scanner, bible, hours) works without Supabase.

# ── CoinMarketCap ─────────────────────────────────────────────────────────────
# BTC/ETH dominance (CMC methodology, matches TradingView) + Alt Season Index
CMC_API_KEY=your_cmc_key_here

# ── PostHog Analytics ─────────────────────────────────────────────────────────
# Get from: https://us.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Grok (xAI) ───────────────────────────────────────────────────────────────
GROK_API_KEY=xai-...

# ── Coinglass ────────────────────────────────────────────────────────────────
# Free tier available - register at coinglass.com to get a key
# Powers: BTC liquidation heatmap (Arena), exchange net flow
COINGLASS_API_KEY=your_coinglass_key_here

# ── Finnhub ───────────────────────────────────────────────────────────────────
FINNHUB_KEY=your_finnhub_key_here

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Random string of your choosing - locks down /api/telegram/webhook so only
# real Telegram calls (which echo this back) are accepted. Set this, then hit
# /api/telegram/setup-webhook once to re-register the webhook with it.
TELEGRAM_WEBHOOK_SECRET=

# ── Cron / internal routes ────────────────────────────────────────────────────
# Protects /api/telegram/alert, /api/macro-alert, /api/signals/track,
# /api/telegram/setup-webhook from being triggered by anyone who finds the URL.
CRON_SECRET=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate keys once: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
# Public key is exposed to the browser (NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:mikocabal27@gmail.com
